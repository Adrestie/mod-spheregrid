#
# mod-spheregrid — configuration
#
# What a server operator tunes: what the content awards, what a stone or a
# statistic rune grants, and what drops where. Nothing else — the
# identifiers the module allocates are not settings, they are part of the
# module and the installer is what adapts them to a server.
#
# Every value below is also the built-in default, so a setting left out changes
# nothing. Reloaded by `.spheregrid reload`, like the rest of the definition.
# The exception: the SphereGrid.Loot.* lines are read by DynamicLoot when the
# server starts, and a family left out drops nothing.
#
# Copy this file to your configs/modules directory and drop the .dist extension.
#

[worldserver]

###############################################################################
#
#    WHAT A STONE GRANTS
#
#    One value per quality — the same five qualities the game itself uses, and
#    the ones the player reads in the colour of the item. Which statistic a
#    stone carries is not a setting: it is written in the stone.
#

SphereGrid.Stone.StatBonus.Common     = 5
SphereGrid.Stone.StatBonus.Uncommon   = 7
SphereGrid.Stone.StatBonus.Rare       = 10
SphereGrid.Stone.StatBonus.Epic       = 15
SphereGrid.Stone.StatBonus.Legendary  = 30

#
#    A cell that comes pre-filled grants less than a stone the player socketed
#    himself: he did nothing to earn it. Same five qualities.
#

SphereGrid.NodeStone.StatBonus.Common     = 1
SphereGrid.NodeStone.StatBonus.Uncommon   = 2
SphereGrid.NodeStone.StatBonus.Rare       = 3
SphereGrid.NodeStone.StatBonus.Epic       = 5
SphereGrid.NodeStone.StatBonus.Legendary  = 7

#
#    How much a statistic rune adds, as a percentage of what the GRID already
#    grants in that statistic. It stacks up to SphereGrid.Runes.PerSpell times.
#

SphereGrid.StatRune.Percent = 10

###############################################################################
#
#    WHAT THE CONTENT AWARDS
#
#    Every number below is Spherite, and every one of them is multiplied by the
#    prismatic Nexuses the account has absorbed.
#

# A quest handed in. Only the player handing it in is credited.
SphereGrid.Points.Quest = 25

# A level gained: this value TIMES the new level, so 20 at level 2. Every level
# crossed at once is counted.
SphereGrid.Points.Level = 10

# An achievement: this value TIMES the achievement's own score, so Blizzard's
# difficulty hierarchy decides and nothing has to be entered by hand.
SphereGrid.Points.Achievement = 10

#
#    The workbench, grinding an item back into Spherite. A rune has no quality,
#    so it has a single price; a stone is priced by its own.
#

SphereGrid.Points.Grind.Rune             = 750
SphereGrid.Points.Grind.Stone.Common     = 100
SphereGrid.Points.Grind.Stone.Uncommon   = 250
SphereGrid.Points.Grind.Stone.Rare       = 500
SphereGrid.Points.Grind.Stone.Epic       = 1000
SphereGrid.Points.Grind.Stone.Legendary  = 2500

###############################################################################
#
#    DUNGEONS
#
#    The tier of a dungeon is computed from its map — its expansion and its
#    difficulty — so nothing has to be listed here: only what each tier is
#    worth.
#

SphereGrid.Points.DungeonBoss.Vanilla      = 75
SphereGrid.Points.DungeonBoss.Bc           = 100
SphereGrid.Points.DungeonBoss.BcHeroic     = 125
SphereGrid.Points.DungeonBoss.Wotlk        = 125
SphereGrid.Points.DungeonBoss.WotlkHeroic  = 150

SphereGrid.Points.DungeonClear.Vanilla     = 50
SphereGrid.Points.DungeonClear.Bc          = 75
SphereGrid.Points.DungeonClear.BcHeroic    = 100
SphereGrid.Points.DungeonClear.Wotlk       = 125
SphereGrid.Points.DungeonClear.WotlkHeroic = 150

# What a dungeon of no known tier awards. Left at a deliberately odd value:
# seeing it in game means a tier is missing above.
SphereGrid.Points.DungeonBoss.Unknown      = 1234
SphereGrid.Points.DungeonClear.Unknown     = 1234

###############################################################################
#
#    RAIDS
#
#    Raids are not tiered by expansion — a vanilla raid and the last raid of an
#    expansion are worlds apart. So each CONTENT TIER is worth what it says
#    below, and lists the maps that belong to it.
#
#    A map is written as its map id x 10. When a raid awards differently by
#    difficulty, add the difficulty index + 1: 6311 is map 631 at difficulty 0,
#    6314 the same map at difficulty 3.
#
#    A server with content of its own adds its maps to a tier: only the pairs
#    below are read, so a tier with no map costs nothing.
#

SphereGrid.Points.Raid.Vanilla   = 250
SphereGrid.Raid.Vanilla.Maps     = 3090,4090,4690,5090,5310

SphereGrid.Points.Raid.Bc        = 450
SphereGrid.Raid.Bc.Maps          = 5320,5340,5440,5480,5500,5640,5650,5680,5800

SphereGrid.Points.Raid.Tier7     = 650
SphereGrid.Raid.Tier7.Maps       = 5330,6150

SphereGrid.Points.Raid.Tier8     = 750
SphereGrid.Raid.Tier8.Maps       = 2490,6030,6240

SphereGrid.Points.Raid.Tier9     = 850
SphereGrid.Raid.Tier9.Maps       = 6490

SphereGrid.Points.Raid.Tier10    = 1000
SphereGrid.Raid.Tier10.Maps      = 6311

SphereGrid.Points.Raid.Tier10Hc  = 1100
SphereGrid.Raid.Tier10Hc.Maps    = 6312,7240

SphereGrid.Points.Raid.Tier25    = 1500
SphereGrid.Raid.Tier25.Maps      = 6313

SphereGrid.Points.Raid.Tier25Hc  = 2000
SphereGrid.Raid.Tier25Hc.Maps    = 6314

# A raid boss on a map listed nowhere. Same deliberately odd value: it is meant
# to be noticed.
SphereGrid.Points.Raid.Unknown   = 1234

###############################################################################
#
#    MYTHIC+ DUNGEONS
#
#    REQUIRES AN EXTERNAL SYSTEM: https://github.com/huptiq/MythicPlus
#
#    The sphere grid has no keystone of its own and knows nothing of mythic
#    dungeons. It only offers the door: an outside system credits a key level by
#    calling `.spheregrid points source mythic_plus <level>`, and the settings
#    below say what that is worth.
#
#    WITHOUT THAT SYSTEM INSTALLED, NOTHING EVER CALLS IT and this whole section
#    is inert. It costs nothing to leave it as it is.
#
#    A scale rather than a list: points = Base + Step x the key level. Set Step
#    to 0 to award a flat amount whatever the key, and Max to the highest level
#    worth rewarding.
#

SphereGrid.Points.MythicPlus.Base = 150
SphereGrid.Points.MythicPlus.Step = 50
SphereGrid.Points.MythicPlus.Max  = 50

###############################################################################
#
#    WHAT EACH SOURCE DROPS
#
#    The items drop through DynamicLoot, the shared loot extension (the
#    dynamicloot module): without it, the sphere grid works and none of its
#    items drops. DynamicLoot sorts every loot source into families -- world
#    creatures, dungeon and raid bosses by expansion, gathering nodes,
#    skinning, chests -- and reads the lines below at start-up. The families
#    and the full syntax are in DynamicLoot's docs/SPECIFICATION.md.
#
#    A LINE is SphereGrid.Loot.<Family> = <draws>:
#
#      <item or list>:<quantity>:<chance>     one draw, the chance in percent
#      a , b                                  b is tried only when a fails
#      a ; b                                  two draws, each with its own dice
#
#    On an item, the quantity is a stack; on a list, that many distinct draws
#    in the list, one item each (two stones are two different statistics).
#
#    THE ITEMS. The six Nexuses: 85100 Depleted, 85101 Flickering, 85102 Luminous,
#    85103 Irradiant, 85104 Solar, 85105 Prismatic. stones[1] to stones[5]: a stone
#    of that quality (common to legendary), its statistic drawn among the
#    sixteen. runes[0]: a rank rune of the whole catalogue, all classes
#    together.
#
#    A family left out drops nothing. A line that cannot be read is reported at
#    start-up and ignored. A grey boss -- below the level at which the game
#    stops giving experience -- yields a fifth of the rate written for it.
#

# The lists
SphereGrid.Loot.stones[1] = [85000, 85005, 85010, 85015, 85020, 85025, 85030, 85035, 85040, 85045, 85050, 85055, 85060, 85065, 85070, 85075]
SphereGrid.Loot.stones[2] = [85001, 85006, 85011, 85016, 85021, 85026, 85031, 85036, 85041, 85046, 85051, 85056, 85061, 85066, 85071, 85076]
SphereGrid.Loot.stones[3] = [85002, 85007, 85012, 85017, 85022, 85027, 85032, 85037, 85042, 85047, 85052, 85057, 85062, 85067, 85072, 85077]
SphereGrid.Loot.stones[4] = [85003, 85008, 85013, 85018, 85023, 85028, 85033, 85038, 85043, 85048, 85053, 85058, 85063, 85068, 85073, 85078]
SphereGrid.Loot.stones[5] = [85004, 85009, 85014, 85019, 85024, 85029, 85034, 85039, 85044, 85049, 85054, 85059, 85064, 85069, 85074, 85079]
SphereGrid.Loot.runes[0] = [85301, 85302, 85303, 85304, 85305, 85306, 85307, 85308, 85309, 85310, 85311, 85312, 85313, 85314, 85315, 85316, 85317, 85318, 85319, 85320, 85321, 85322, 85323, 85324, 85325, 85326, 85328, 85329, 85330, 85331, 85332, 85333, 85334, 85335, 85336, 85337, 85338, 85339, 85340, 85341, 85342, 85343, 85344, 85345, 85346, 85347, 85348, 85349, 85350, 85351, 85352, 85353, 85354, 85355, 85356, 85357, 85358, 85359, 85360, 85361, 85362, 85363, 85364, 85365, 85366, 85367, 85368, 85369, 85370, 85371, 85372, 85373, 85374, 85375, 85376, 85377, 85378, 85379, 85380, 85381, 85382, 85383, 85384, 85385, 85386, 85388, 85389, 85390, 85391, 85392, 85393, 85394, 85395, 85396, 85397, 85398, 85399, 85400, 85401, 85402, 85403, 85404, 85405, 85406, 85407, 85408, 85409, 85410, 85411, 85412, 85413, 85414, 85415, 85416, 85417, 85418, 85419, 85420, 85421, 85422, 85423, 85424, 85425, 85426, 85427, 85428, 85429, 85430, 85431, 85432, 85433, 85434, 85435, 85436, 85437, 85438, 85439, 85440, 85441, 85442, 85443, 85444, 85445, 85446, 85447, 85448, 85449, 85450, 85451, 85453, 85454, 85455, 85456, 85457]

# How often everything drops: a percentage of the rates written below. 100 as
# written, 50 halves them, 200 doubles them, 0 turns the module's loot off.
SphereGrid.Loot.Rate = 100

# The bad luck protection, shared by every module that uses DynamicLoot, adds
# its points to every draw but these items'. Any item won resets it.
SphereGrid.Loot.NoPity = [85105]

#
#    MONSTERS
#
#    "Trash" is every monster of the place that is not a boss; "World" is
#    everything outside an instance, its world bosses and rares apart.
#

SphereGrid.Loot.IcecrownRaidBoss = 85105:1:2 ; 85104:1:25 , 85103:1:100 ; stones[5]:1:25 , stones[4]:2:50 , stones[4]:1:100 ; runes[0]:1:33
SphereGrid.Loot.WotlkRaidBoss = 85105:1:2 ; 85103:1:100 ; stones[4]:1:100 ; runes[0]:1:10
SphereGrid.Loot.WotlkRaidTrash = 85102:1:5 ; stones[4]:1:2 ; runes[0]:1:2
SphereGrid.Loot.WotlkHeroicBoss = 85102:1:25 ; stones[3]:1:25
SphereGrid.Loot.WotlkHeroicTrash = 85102:1:6 ; stones[3]:1:6
SphereGrid.Loot.WotlkDungeonBoss = 85102:2:20 ; stones[3]:1:15
SphereGrid.Loot.WotlkDungeonTrash = 85102:1:5 ; stones[2]:1:4
SphereGrid.Loot.WotlkWorld = 85102:1:5 ; stones[2]:1:3
SphereGrid.Loot.WotlkWorldBoss = 85102:1:5 ; stones[2]:1:3
SphereGrid.Loot.WotlkRare = 85102:1:5 ; stones[2]:1:3
SphereGrid.Loot.BcRaidBoss = 85101:2:7 ; stones[2]:1:15
SphereGrid.Loot.BcRaidTrash = 85101:1:8 ; stones[2]:1:5
SphereGrid.Loot.BcDungeonBoss = 85101:1:5 ; stones[1]:1:5
SphereGrid.Loot.BcDungeonTrash = 85101:1:5.5 ; stones[1]:1:5
SphereGrid.Loot.BcWorld = 85101:1:5 ; stones[1]:1:3
SphereGrid.Loot.BcWorldBoss = 85101:1:5 ; stones[1]:1:3
SphereGrid.Loot.BcRare = 85101:1:5 ; stones[1]:1:3
SphereGrid.Loot.VanillaRaidBoss = 85101:2:7
SphereGrid.Loot.VanillaRaidTrash = 85100:1:8
SphereGrid.Loot.VanillaDungeonBoss = 85100:1:5
SphereGrid.Loot.VanillaDungeonTrash = 85100:1:5.5
SphereGrid.Loot.VanillaWorld = 85100:1:5
SphereGrid.Loot.VanillaWorldBoss = 85100:1:5
SphereGrid.Loot.VanillaRare = 85100:1:5

#
#    VEINS AND HERBS
#
#    By the skill the node demands and the expansion of its map. Low: Cobalt;
#    Goldclover, Fire Leaf, Tiger Lily. Medium: Saronite; Talandra's Rose,
#    Adder's Tongue, Lichbloom. High: Titanium; Icethorn, Frost Lotus.
#

SphereGrid.Loot.VanillaOres = 85100:1:5
SphereGrid.Loot.BcOres = 85101:1:5
SphereGrid.Loot.WotlkOresLow = 85102:1:5
SphereGrid.Loot.WotlkOresMedium = 85102:1:9
SphereGrid.Loot.WotlkOresHigh = 85103:1:5 , 85102:1:12
SphereGrid.Loot.VanillaHerbs = 85100:1:5
SphereGrid.Loot.BcHerbs = 85101:1:5
SphereGrid.Loot.WotlkHerbsLow = 85102:1:5
SphereGrid.Loot.WotlkHerbsMedium = 85102:1:7
SphereGrid.Loot.WotlkHerbsHigh = 85102:1:9

#
#    SKINNING, by the level of the beast, and the corpses gathered by
#    herbalism, mining or engineering, by the expansion of their map.
#

SphereGrid.Loot.Skinning80 = 85103:1:9
SphereGrid.Loot.Skinning71 = 85102:1:5
SphereGrid.Loot.Skinning61 = 85101:1:5
SphereGrid.Loot.Skinning1 = 85100:1:5
SphereGrid.Loot.VanillaCorpseHerbs = 85100:1:5
SphereGrid.Loot.VanillaCorpseOres = 85100:1:5
SphereGrid.Loot.VanillaCorpseSalvage = 85100:1:5
SphereGrid.Loot.BcCorpseHerbs = 85101:1:5
SphereGrid.Loot.BcCorpseOres = 85101:1:5
SphereGrid.Loot.BcCorpseSalvage = 85101:1:5
SphereGrid.Loot.WotlkCorpseHerbs = 85102:1:5
SphereGrid.Loot.WotlkCorpseOres = 85102:1:5
SphereGrid.Loot.WotlkCorpseSalvage = 85102:1:5

#
#    CHESTS, by where the chest stands. A boss's chest is the boss's loot: it
#    drops what the boss's family above says.
#

SphereGrid.Loot.WorldChest = 85100:1:12
SphereGrid.Loot.DungeonChest = 85100:3:10
SphereGrid.Loot.HeroicDungeonChest = 85100:5:10

###############################################################################
#
#    RULES
#

# The price of a cell is its distance in edges from the class start, times this
# step, capped. The start itself is free.
SphereGrid.Cost.PerStep = 75
SphereGrid.Cost.Cap = 2500

# How many identical runes may be socketed in one grid. Beyond that, the extra
# rune grants nothing.
SphereGrid.Runes.PerSpell = 3

###############################################################################
#
#    SUMMONS
#
#    The creatures the class spells call up fight with a share of their
#    master's power, added to their own attack power: the game turns it into
#    melee damage (attack power / 14 per second of attack time) and adds it to
#    the spells they cast. Read at every summon.
#

# Apocalypse's ghouls: share of the death knight's attack power.
SphereGrid.Summon.Ghoul.AttackPowerShare = 0.75

# The demonic tyrant: share of the warlock's shadow spell power.
SphereGrid.Summon.Tyrant.SpellPowerShare = 2

# Stampede's beasts: share of the hunter's ranged attack power.
SphereGrid.Summon.Pack.RangedAttackPowerShare = 0.125
